RECAPTCHA_SECRET_KEY=
cj_email=
cj_password=

# Optional demo analytics; complete DEMO_ANALYTICS_SETUP.md before enabling.
CJ_ANALYTICS_ENABLED=0
CJ_ANALYTICS_DB_PATH=/var/data/codejet-demo-analytics.sqlite3
CJ_ANALYTICS_ADMIN_TOKEN=
CJ_ANALYTICS_ORIGIN_KEY=
CJ_ANALYTICS_FRONTDOOR_ID=
CJ_ANALYTICS_ALLOWED_ORIGINS=https://codejet.app,https://www.codejet.app
CJ_ANALYTICS_IP_MODE=frontdoor
CJ_ANALYTICS_LOCAL_DEV=0
CJ_ANALYTICS_RETENTION_DAYS=30

# Search and video campaign configuration
# Add values to the EXISTING Render service environment; retain all current
# contact/SMTP, reCAPTCHA, and CJ_ANALYTICS_* configuration. Never commit secrets.

# Public pages are indexable only on the recognized CodeJet public host or its
# configured Front Door route. Set 0 to intentionally noindex a preview.
CJ_SEO_INDEXABLE=1

# Optional override; otherwise the existing CJ_ANALYTICS_FRONTDOOR_ID is reused
# for SEO host selection. This is NOT an authentication secret or an auth check.
CJ_SEO_FRONTDOOR_ID=

# Optional genuine token from Search Console's URL-prefix HTML-tag method.
# Not needed when using a verified DNS Domain property.
CJ_GOOGLE_SITE_VERIFICATION=

# Leave disabled until the original publication date and thumbnail are verified.
# This date is the original video's publication date, NOT this website's release.
CJ_VIDEO_SCHEMA_ENABLED=0
CJ_VIDEO_UPLOAD_DATE=
CJ_VIDEO_THUMBNAIL_URL=https://customer-0k2chsytrbkmpgjr.cloudflarestream.com/38ccab99e8156adae4abcfbb1d36cc0f/thumbnails/thumbnail.jpg?time=20s&height=600
# Optional actual runtime as ISO 8601 duration. No duration is assumed.
CJ_VIDEO_DURATION=
